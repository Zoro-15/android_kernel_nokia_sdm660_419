# Fingerprint
CONFIG_FINGERPRINT_614R=y

# NFC
CONFIG_SEC_NFC=y
# CONFIG_SEC_NFC_CLK_REQ is not set
CONFIG_SEC_NFC_IF_I2C=y
# CONFIG_SEC_NFC_IF_I2C_GPIO is not set
# CONFIG_SEC_NFC_IF_UART is not set
# CONFIG_SEC_NFC_PRODUCT_N3 is not set
CONFIG_SEC_NFC_PRODUCT_N5=y

# Platform
CONFIG_FIH_PLATE2=y
CONFIG_FIH_SDM630_SDM660_PROJS=y

# Touchscreen
CONFIG_TOUCHSCREEN_FTS_FIH=y
CONFIG_TOUCHSCREEN_GX=y
