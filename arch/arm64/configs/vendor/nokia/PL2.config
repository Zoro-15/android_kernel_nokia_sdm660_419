# Fingerprint
CONFIG_FINGERPRINT_614R=y

# NFC
CONFIG_SEC_NFC=y
# CONFIG_SEC_NFC_CLK_REQ is not set
CONFIG_SEC_NFC_IF_I2C=y
# CONFIG_SEC_NFC_IF_I2C_GPIO is not set
# CONFIG_SEC_NFC_IF_UART is not set
# CONFIG_SEC_NFC_PRODUCT_N3 is not set
CONFIG_SEC_NFC_PRODUCT_N5=y

# Platform
CONFIG_FIH_PLATE2=y
CONFIG_FIH_SDM630_SDM660_PROJS=y

# Touchscreen
CONFIG_TOUCHSCREEN_FTS_FIH=y
CONFIG_TOUCHSCREEN_GX=y

# Watchdog & Panic (Prevent reboot loops during bringup)
CONFIG_POWER_RESET_MSM=y
CONFIG_QCOM_WATCHDOG_V2=n
CONFIG_QCOM_FORCE_WDOG_BITE_ON_PANIC=n
CONFIG_PANIC_TIMEOUT=30

# Simplefb Early Console (Display boot and panic logs directly on screen)
CONFIG_FB_EARLY=y

# Powerkey Force Crash (Hold Power key for 4s to force panic & ramoops dump)
CONFIG_POWERKEY_FORCECRASH=y
CONFIG_POWERKEY_FORCECRASH_TIMEOUT=4

