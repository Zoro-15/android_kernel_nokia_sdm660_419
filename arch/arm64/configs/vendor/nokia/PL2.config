# Amplifier
CONFIG_SND_SOC_TFA9891=y

# Fingerprint
CONFIG_FINGERPRINT_614R=y

# NFC
CONFIG_SEC_NFC=y
# CONFIG_SEC_NFC_CLK_REQ is not set
CONFIG_SEC_NFC_IF_I2C=y
# CONFIG_SEC_NFC_IF_I2C_GPIO is not set
# CONFIG_SEC_NFC_IF_UART is not set
# CONFIG_SEC_NFC_PRODUCT_N3 is not set
CONFIG_SEC_NFC_PRODUCT_N5=y

# Platform (Include both PL2 and B2N for unlocked bootloader DTB compatibility)
CONFIG_FIH_PLATE2=y
CONFIG_FIH_ONYX=y
CONFIG_FIH_SDM630_SDM660_PROJS=y

# Display Backlight Boost Converter
CONFIG_BOOST_CONVERTER_SUPPORT=y
CONFIG_BOOST_NT50356=y

# Touchscreen
CONFIG_TOUCHSCREEN_FTS_FIH=y
CONFIG_TOUCHSCREEN_GX=y
CONFIG_TOUCHSCREEN_NT36xxx_FIH=y

# Framebuffer Console (FBCon on Screen for Early Bringup Display & Panics)
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y

# Early Console Cmdline
CONFIG_CMDLINE="console=tty0"
CONFIG_CMDLINE_EXTEND=y
