# Audio
CONFIG_SPEAKER_EXT_PA=y
CONFIG_SPEAKER_EXT_PA_AW87318=y

# Charging
# CONFIG_SMB1351_USB_CHARGER is not set
# CONFIG_SMB138X_CHARGER is not set

# Display
CONFIG_PXLW_IRIS3=y

# Fingerprint
CONFIG_FINGERPRINT_SUNWAVE=y

# Misc
CONFIG_I2C_DEVINFO=y
CONFIG_ANT_CHECK=y
CONFIG_ABOV_SAR=y

# NFC
# CONFIG_NFC_NQ is not set
CONFIG_SEC_NFC=y
CONFIG_SEC_NFC_PRODUCT_N5=y
CONFIG_SEC_NFC_IF_I2C=y
CONFIG_SEC_NFC_CLK_REQ=y

# TEE
CONFIG_TRUSTONIC_TEE=y
CONFIG_TRUSTONIC_TEE_LPAE=y
# CONFIG_TRUSTONIC_TEE_DEBUG is not set

# Touchscreen
CONFIG_LC_TOUCHSCREEN_INFO=y
CONFIG_TOUCHSCREEN_FTS_LC=y
CONFIG_TOUCHSCREEN_HIMAX=y
CONFIG_TOUCHSCREEN_HIMAX_CHIPSET=y
CONFIG_TOUCHSCREEN_HIMAX_INCELL=y
CONFIG_TOUCHSCREEN_HIMAX_IC_HX83112=y
CONFIG_TOUCHSCREEN_HIMAX_COMMON=y
CONFIG_TOUCHSCREEN_HIMAX_DEBUG=y
CONFIG_TOUCHSCREEN_HIMAX_INSPECT=y

# Platform
CONFIG_LONGCHEER_SDM660_PROJS=y
CONFIG_LONGCHEER_STARLORD=y
CONFIG_BUILD_ARM64_DT_OVERLAY=y
