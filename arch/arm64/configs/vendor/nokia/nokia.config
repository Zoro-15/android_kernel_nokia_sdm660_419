# A/B
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y
CONFIG_PROC_CMDLINE_APPEND_ANDROID_FORCE_NORMAL_BOOT=y

# BPF
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_NETFILTER_XT_MATCH_BPF=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_QUOTA2_LOG=y
CONFIG_NET_ACT_BPF=y
CONFIG_NET_CLS_BPF=y

# Debug
# CONFIG_QCOM_PRESERVE_MEM is not set

# Filesystems
CONFIG_EXFAT_FS=y
CONFIG_NTFS_FS=y

# Fingerprint
CONFIG_INPUT_FINGERPRINT=y

# Misc
CONFIG_BLK_CGROUP=y
CONFIG_CRYPTO_ECHAINIV=y
CONFIG_IOSCHED_BFQ=y
CONFIG_OVERLAY_FS=y
CONFIG_SUSPEND_SKIP_SYNC=y
CONFIG_THIN_ARCHIVES=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y

# NFC
CONFIG_NFC=y

# OTG
CONFIG_USB_MSM_OTG=y
CONFIG_USB_OTG=y

# Platform
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
# CONFIG_CC_OPTIMIZE_FOR_SIZE is not set

# Pstore
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_FTRACE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# VDSO
CONFIG_COMPAT_VDSO=y

# Wi-Fi
CONFIG_QCA_CLD_WLAN=y

# Wireguard
CONFIG_WIREGUARD=y

# WERROR
CONFIG_CC_WERROR=n

# Disable debugging configs
# CONFIG_SKY2 is not set
# CONFIG_SMSC911X is not set
# CONFIG_INPUT_HBTP_INPUT is not set
# CONFIG_SERIAL_MSM is not set
# CONFIG_SERIAL_MSM_CONSOLE is not set
# CONFIG_PINCTRL_MSM8998 is not set
# CONFIG_MSM_QBT1000 is not set
# CONFIG_CGROUP_DEBUG is not set
# CONFIG_UTS_NS is not set
# CONFIG_VIDEO_ADV_DEBUG is not set
# CONFIG_MSM_CAMERA_DEBUG is not set
# CONFIG_MSMB_CAMERA_DEBUG is not set
# CONFIG_MSM_SDE_ROTATOR_EVTLOG_DEBUG is not set
# CONFIG_IOMMU_DEBUG is not set
# CONFIG_WIREGUARD_DEBUG is not set
# CONFIG_IOSCHED_TEST is not set
# CONFIG_BRIDGE_NETFILTER is not set
# CONFIG_SCSI_UFS_TEST is not set
# CONFIG_WIL6210 is not set
# CONFIG_MSM_RDBG is not set
# CONFIG_USB_GSPCA is not set
# CONFIG_DVB_MPQ is not set
# CONFIG_MSM_11AD is not set
# CONFIG_TRACING_SUPPORT is not set
# CONFIG_CMA_DEBUGFS is not set
# CONFIG_RMNET_DATA_DEBUG_PKT is not set
# CONFIG_MSM_IDLE_STATS is not set
# CONFIG_FB_MSM_MDSS_XLOG_DEBUG is not set
# CONFIG_MSM_TZ_LOG is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_DEBUG_SET_MODULE_RONX is not set
# CONFIG_DEBUG_ALIGN_RODATA is not set
# CONFIG_CORESIGHT is not set
