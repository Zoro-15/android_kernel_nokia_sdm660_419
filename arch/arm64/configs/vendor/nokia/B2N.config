# Display
CONFIG_BOOST_CONVERTER_SUPPORT=y
CONFIG_BOOST_NT50356=y

# External charge drivers
CONFIG_CHARGER_BQ25600_SLAVE=y

# Fingerprint
CONFIG_FINGERPRINT_GF5288=y

# Haptics
CONFIG_HAPTICS_DRV2605=y

# Platform
CONFIG_FIH_ONYX=y
CONFIG_FIH_SDM630_SDM660_PROJS=y

# Touchscreen
CONFIG_TOUCHSCREEN_FTS_FIH=y
CONFIG_TOUCHSCREEN_NT36xxx_FIH=y
