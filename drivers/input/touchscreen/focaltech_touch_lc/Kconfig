#
# Focaltech Touchscreen driver configuration
#

config TOUCHSCREEN_FTS_LC
    bool "Focaltech Touchscreen for Longcheer devices"
    default n
    help
      Say Y here if you have Focaltech touch panel for Longcheer devices.
      If unsure, say N.
      
config TOUCHSCREEN_FTS_DIRECTORY
    string "Focaltech ts directory name"
    default "focaltech_touch"
    depends on TOUCHSCREEN_FTS
